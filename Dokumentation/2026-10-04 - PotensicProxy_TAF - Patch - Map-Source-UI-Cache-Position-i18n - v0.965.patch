index 0000000000000000000000000000000000000000..f946280aa2f66b0f04ed7eaa48db13a9ead992d5
--- /dev/null
+++ b/webui/src/utils/mapProjection.ts
@@ -0,0 +1,22 @@
+export function worldPoint(longitude: number, latitude: number, zoom: number) {
+  const n = 256 * Math.pow(2, zoom)
+  const safeLatitude = Math.max(-85.05112878, Math.min(85.05112878, latitude))
+  const x = (longitude + 180) / 360 * n
+  const s = Math.sin(safeLatitude * Math.PI / 180)
+  const y = (0.5 - Math.log((1 + s) / (1 - s)) / (4 * Math.PI)) * n
+  return { x, y }
+}
+
+export function geoPoint(x: number, y: number, zoom: number) {
+  const n = 256 * Math.pow(2, zoom)
+  const longitude = x / n * 360 - 180
+  const a = Math.PI * (1 - 2 * y / n)
+  const latitude = 180 / Math.PI * Math.atan(Math.sinh(a))
+  return { latitude, longitude }
+}
+
+export function screenPoint(latitude: number, longitude: number, centerLatitude: number, centerLongitude: number, zoom: number, width: number, height: number) {
+  const center = worldPoint(centerLongitude, centerLatitude, zoom)
+  const point = worldPoint(longitude, latitude, zoom)
+  return { x: point.x - center.x + width / 2, y: point.y - center.y + height / 2 }
+}
